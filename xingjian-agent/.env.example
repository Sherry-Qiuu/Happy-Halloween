# Xingjian agent service - copy this file to .env and fill in the key.
# The file is read on start; environment variables always win.

# --- DeepSeek ---------------------------------------------------------
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# OpenAI compatible endpoint. Use https://api.deepseek.com (without /v1)
# if you are on the older path; both work.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# deepseek-chat is fast and cheap. deepseek-reasoner is slower and
# spends more tokens on reasoning; good for hard planning questions.
DEEPSEEK_MODEL=deepseek-chat

# --- Server -----------------------------------------------------------
# 127.0.0.1 keeps the demo on your laptop. Use 0.0.0.0 in Docker or on
# a server that sits behind a reverse proxy.
HOST=127.0.0.1
PORT=8000

# --- Accounts and data ------------------------------------------------
# Where accounts.json, sessions.json and data/<user_id>.json live.
# Local default: ../server information (next to this folder).
# Docker sets this to /data through docker-compose.yml.
# XINGJIAN_DATA_DIR=E:\UNNC_Y1_FAM\黑客松\server information
# Session lifetime in days.
XINGJIAN_SESSION_DAYS=7
# 1 only when the site is served over HTTPS. A Secure cookie is refused
# on plain http://127.0.0.1, which would make login fail locally.
COOKIE_SECURE=0
# 0 closes public registration. Create the accounts you need first.
XINGJIAN_ALLOW_REGISTRATION=1
XINGJIAN_MAX_USERS=5000
# 1 when nginx/Caddy forwards X-Forwarded-For, so rate limits see the
# real client address instead of the proxy.
XINGJIAN_TRUST_PROXY=0

# --- Agent behavior ---------------------------------------------------
# 1 = answer from the built-in offline mock, no key needed.
AGENT_MOCK=0
AGENT_TEMPERATURE=0.4
AGENT_MAX_TOKENS=1200
# Seconds before the upstream call is abandoned.
AGENT_TIMEOUT=60
# Requests per minute per client IP.
AGENT_RATE_LIMIT=40
# How many previous messages are replayed as context.
AGENT_MAX_HISTORY=8
# Allowed browser origins. "null" covers opening index.html from disk.
# Set this to your real domain before putting the service on the internet.
AGENT_CORS_ORIGINS=null,http://127.0.0.1,http://localhost
